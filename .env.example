# === API KEYS ===
# Get a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === SUPABASE (Features 7 & 10: Scan History + Shareable Reports) ===
# Create a free project at https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === HUGGING FACE (Feature 5: Paraphrase Detection) ===
# Get a free token at https://huggingface.co/settings/tokens
# Leave blank to use built-in word-overlap fallback (no token needed)
HF_TOKEN=hf_your_huggingface_token_here

# === DEPLOYMENT SETTINGS ===
# For local development, this defaults to 3001
PORT=3001

# For Vercel/Netlify, make sure to add all keys above to your project environment variables.
# The backend will automatically switch to memory storage for file uploads in production.
